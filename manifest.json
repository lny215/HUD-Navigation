{
  "manifest_version": 3,
  "name": "HUD Navigation Tool",
  "version": "1.0.0",
  "description": "웹페이지 H태그 트리 구조 및 ALT, P태그 요소 시각화 툴",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ]
}